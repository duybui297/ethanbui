# Public site URL (used for sitemap, OG, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM="Ethan <hello@your-domain.com>"
CONTACT_TO_EMAIL=you@your-domain.com
# Auto-subscribe product sign-ups into the Resend audience.
# Contacts API needs a FULL-ACCESS key — RESEND_API_KEY may be sending-only.
RESEND_CONTACTS_API_KEY=
# Optional: pin the audience; otherwise the first audience is used.
RESEND_AUDIENCE_ID=

# Beehiiv (newsletter)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional: rate-limit secret
RATE_LIMIT_SECRET=change-me
